prelude::import("prelude");

map :: proc(x_fn: proc($1) -> $2) -> proc(list[$1]) -> list[$2]{
    return proc(x_list: list[$1]) -> list[$2] {
        return [x_fn(x) | x:$1 <- x_list];
    }
}

add1 :: proc(x: int) int {
    return x + 1;
}

add2 :: proc(x:int) {
    
}

main :: proc() -> void {
    result := map(add1)([1,2,3,4]);
    print(result);
    result |> print;
}